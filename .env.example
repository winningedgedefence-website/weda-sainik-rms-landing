# ----------------------------------------------------------------
# WEDA landing page - server environment
# Copy to .env.local (or paste into Vercel > Settings > Environment Variables).
# NEVER commit real secrets. NEVER put a KEY_SECRET in index.html.
# ----------------------------------------------------------------

# "test" while you are testing, "live" when you go live. Nothing else changes.
RAZORPAY_MODE=test

# --- TEST MODE (Razorpay Dashboard > Test Mode > Account & Settings > API Keys)
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_TEST_WEBHOOK_SECRET=choose_any_long_random_string

# --- LIVE MODE (fill in only when you are ready to take real money)
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# --- Where registrations and enquiries are stored
# memory  = nothing is persisted (local testing only)
# file    = .data/*.json  (use on a VPS, NOT on Vercel)
# upstash = Upstash Redis REST (recommended on Vercel - free tier is enough)
STORE_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: every enquiry and every CONFIRMED payment is POSTed here as JSON.
# A Google Apps Script web app, Zapier/Make hook or your CRM endpoint.
# Set this and you always have a durable record, whatever STORE_DRIVER you use.
NOTIFY_WEBHOOK_URL=

# --- Lock the API to your own domain once deployed, e.g. https://thewinningedge.co.in
ALLOWED_ORIGIN=*
